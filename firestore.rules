rules_version = '2';

// Security rules for the GitHub Pages + Firebase chat.
//
// There is no login, so rules can't restrict by user identity. Instead they
// lock down the *shape* of data: group metadata is write-once, messages and
// presence are size-limited and can't be edited or deleted by others. This
// prevents tampering with existing history and keeps abuse bounded, while
// still allowing the anonymous, no-login flow the app is built around.
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is any signed-in user with a document in /admins keyed by their
    // uid. exists() is evaluated server-side and ignores the /admins read rule
    // below, so admin status can't be probed or forged from a browser.
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin roster. Managed only from the Firebase Console — never readable or
    // writable from the app, so nobody can grant themselves access.
    match /admins/{uid} {
      allow read, write: if false;
    }

    match /groups/{code} {
      // Anyone who knows a group's code can look it up (the join screen needs
      // this). Listing the collection is admin-only: without that split, any
      // visitor could enumerate every group ever created and read all of them.
      allow get: if true;
      allow list: if isAdmin();

      // A group can be created once, with exactly these fields. Its name and
      // passcode hash are then immutable — nobody can rename or unlock it.
      allow create: if request.resource.data.keys().hasOnly(['name', 'passHash', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.passHash is string
                    && request.resource.data.passHash.size() <= 128;
      allow update, delete: if false;

      match /messages/{message} {
        allow read: if true;
        // New messages only; correct shape and length; no editing/deleting.
        allow create: if request.resource.data.keys().hasOnly(['sender', 'body', 'ts'])
                      && request.resource.data.sender is string
                      && request.resource.data.sender.size() <= 40
                      && request.resource.data.body is string
                      && request.resource.data.body.size() > 0
                      && request.resource.data.body.size() <= 4000
                      && request.resource.data.ts is number;
        allow update, delete: if false;
      }

      match /presence/{clientId} {
        allow read: if true;
        // Presence heartbeats: a name + timestamp, or deletion on leave.
        allow write: if request.resource == null
                     || (request.resource.data.name is string
                         && request.resource.data.name.size() <= 40
                         && request.resource.data.lastSeen is number);
      }
    }
  }
}
